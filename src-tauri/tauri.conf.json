{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDF Flow",
  "version": "0.1.0",
  "identifier": "com.rdfflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RDF Flow",
        "width": 520,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "../assets/icon-32.png",
      "tooltip": "RDF Flow - AI Voice-to-Text"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon-32.png",
      "../assets/icon-128.png",
      "../assets/icon-256.png",
      "../assets/icon-512.png",
      "../assets/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
