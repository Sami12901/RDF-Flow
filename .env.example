# ==========================================
# RDF Flow — Environment Configuration
# ==========================================

# Active STT Provider: groq | google | openai | deepgram | local
RDF_STT_PROVIDER=groq

# Active AI Polishing Mode: casual | professional | code | bullets | raw
RDF_TONE_MODE=casual

# Global Dictation Hotkey (e.g. Ctrl+Space, F8, Alt+D)
RDF_HOTKEY=Ctrl+Space

# Auto-inject text at active cursor location (true | false)
RDF_AUTO_INJECT=true

# ------------------------------------------
# Cloud Provider API Keys
# ------------------------------------------

# Groq API Key (Recommended for ultra-fast <250ms speech-to-text; free tier available)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini / Speech API Key (Generous free tier)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy_your_google_api_key_here

# OpenAI API Key (Whisper-1)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_api_key_here

# Deepgram API Key (Nova-2 real-time STT)
# Get a key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------
# Local Offline Whisper Configuration
# ------------------------------------------
# Path to local whisper.cpp GGML model or ONNX model
LOCAL_WHISPER_MODEL_PATH=models/ggml-base.bin

# Audio Silence Detection (auto-stop recording after N milliseconds of silence)
RDF_SILENCE_THRESHOLD_MS=1500
